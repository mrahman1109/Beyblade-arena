# ── Odoo Online ─────────────────────────────────────────────────────────────
# Your Odoo instance URL (e.g. https://mycompany.odoo.com)
ODOO_URL=https://yourinstance.odoo.com
ODOO_DB=your_database_name
# Generate in Odoo → Settings → Technical → API Keys
ODOO_API_KEY=your_odoo_api_key
# Odoo login email (used alongside the API key)
ODOO_USERNAME=admin@yourcompany.com

# ── Skytrust ─────────────────────────────────────────────────────────────────
# Your Skytrust tenant URL (e.g. https://yourcompany.skytrust.com.au)
SKYTRUST_URL=https://yourcompany.skytrust.com.au
# API credentials — request from Skytrust support or Settings → Integrations
SKYTRUST_API_KEY=your_skytrust_api_key
SKYTRUST_CLIENT_ID=your_client_id
SKYTRUST_CLIENT_SECRET=your_client_secret

# ── Live Sync ─────────────────────────────────────────────────────────────────
# Secret token Odoo sends in X-Odoo-Webhook-Secret header (choose any string)
WEBHOOK_SECRET=choose_a_random_secret_string

# Scheduler intervals (minutes) — adjust to suit your data volumes
TIMESHEET_SYNC_INTERVAL_MINUTES=5
ATTENDANCE_SYNC_INTERVAL_MINUTES=15
EMPLOYEE_SYNC_INTERVAL_MINUTES=60
INCIDENT_SYNC_INTERVAL_MINUTES=60
